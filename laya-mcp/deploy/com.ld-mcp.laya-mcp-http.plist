<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.ld-mcp.laya-mcp-http</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/USERNAME/.venvs/laya-mlx-t1/bin/laya-mcp-http</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>EnvironmentVariables</key>
	<dict>
		<key>LAYA_CHECKPOINT_ENGLISH</key>
		<string>aac6fef/laya-mlx</string>
		<key>LAYA_CHECKPOINT_TYPED_DECISIONS</key>
		<string>aac6fef/laya-typed-decisions-mlx</string>
		<key>LAYA_ROUTE_DEFAULT</key>
		<string>typed-decisions</string>
		<key>LAYA_PRELOAD</key>
		<string>1</string>
		<key>LAYA_MCP_HOST</key>
		<string>0.0.0.0</string>
		<key>LAYA_MCP_PORT</key>
		<string>8765</string>
		<key>LAYA_MCP_TLS_CERT</key>
		<string>/Users/USERNAME/.config/laya-mcp/tls/laya-mcp.pem</string>
		<key>LAYA_MCP_TLS_KEY</key>
		<string>/Users/USERNAME/.config/laya-mcp/tls/laya-mcp-key.pem</string>
	</dict>
	<key>StandardOutPath</key>
	<string>/Users/USERNAME/Library/Logs/com.ld-mcp.laya-mcp-http.out.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/USERNAME/Library/Logs/com.ld-mcp.laya-mcp-http.err.log</string>
</dict>
</plist>
